<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>BusReservationJDBC_Task4</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Book Seat Servlet -->
    <servlet>
        <servlet-name>BookSeatServlet</servlet-name>
        <servlet-class>BookSeatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookSeatServlet</servlet-name>
        <url-pattern>/BookSeatServlet</url-pattern>
    </servlet-mapping>

    <!-- Cancel Seat Servlet -->
    <servlet>
        <servlet-name>CancelSeatServlet</servlet-name>
        <servlet-class>CancelSeatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CancelSeatServlet</servlet-name>
        <url-pattern>/CancelSeatServlet</url-pattern>
    </servlet-mapping>

    <!-- Check Availability Servlet -->
    <servlet>
        <servlet-name>CheckAvailabilityServlet</servlet-name>
        <servlet-class>CheckAvailabilityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckAvailabilityServlet</servlet-name>
        <url-pattern>/CheckAvailabilityServlet</url-pattern>
    </servlet-mapping>

</web-app>
